// https://webaudio.github.io/web-audio-api/#OfflineAudioContextOptions
dictionary OfflineAudioContextOptions {
    unsigned long numberOfChannels = 1;
    unsigned long? length = null;
    required float sampleRate;
    AudioContextRenderSizeHint renderSizeHint = "default";
};

// https://webaudio.github.io/web-audio-api/#OfflineAudioContext
[Exposed=Window, ImplementedIn=Rust]
interface OfflineAudioContext : BaseAudioContext {
    [ImplementedAs=construct_options] constructor(OfflineAudioContextOptions contextOptions);
    [ImplementedAs=construct_channels] constructor(unsigned long numberOfChannels, unsigned long length, float sampleRate);
    [CreatesPromise] Promise<AudioBuffer> startRendering(optional unsigned long? chunkSize = null);
    [CreatesPromise] Promise<undefined> resume();
    [CreatesPromise] Promise<undefined> suspend(double suspendTime);
    [CreatesPromise] Promise<undefined> close();
    readonly attribute unsigned long? length;
    attribute EventHandler oncomplete;
};
